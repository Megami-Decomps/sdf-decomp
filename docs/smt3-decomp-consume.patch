+++ b/tools/test_sources.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+"""Tests for game_source, the per-game view of a shared unit."""
+import sys
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from sources import game_source, logical, physical  # noqa: E402
+
+SOURCE = """a
+#if defined(SDF_DDS1) || defined(SDF_DDS2)
+dds
+#ifdef NON_MATCHING
+draft
+#else
+asm
+#endif
+#elif defined(SDF_SMT3)
+smt3
+#endif
+#ifndef SDF_DDS2
+not_dds2
+#else
+dds2
+#endif
+"""
+
+
+def kept(version):
+    return [line for line in game_source(SOURCE, version).split("\n") if line.strip()]
+
+
+class GameSourceTest(unittest.TestCase):
+    def test_branches_per_game(self):
+        self.assertEqual(kept("smt3"), ["a", "smt3", "not_dds2"])
+        self.assertEqual(kept("dds1"), ["a", "dds", "#ifdef NON_MATCHING", "draft", "#else", "asm",
+                                        "#endif", "not_dds2"])
+        self.assertEqual(kept("dds2"), ["a", "dds", "#ifdef NON_MATCHING", "draft", "#else", "asm",
+                                        "#endif", "dds2"])
+
+    def test_offsets_kept(self):
+        self.assertEqual(len(game_source(SOURCE, "dds1")), len(SOURCE))
+        self.assertEqual(game_source(SOURCE, "dds1").count("\n"), SOURCE.count("\n"))
+
+    def test_draft_or_games(self):
+        text = "#if defined(NON_MATCHING) || defined(SDF_DDS1) || defined(SDF_DDS2)\nc\n#else\nasm\n#endif\n"
+        self.assertEqual(game_source(text, "dds1").split("\n")[1:4], ["c", "     ", "   "])
+        smt3 = game_source(text, "smt3")
+        self.assertEqual(smt3.split("\n")[0].rstrip(), "#ifdef NON_MATCHING")
+        self.assertEqual(smt3.split("\n")[1:4], ["c", "#else", "asm"])
+        self.assertEqual(len(smt3), len(text))
+
+    def test_mixed_condition_fails(self):
+        with self.assertRaises(ValueError):
+            game_source("#if defined(SDF_DDS1) && FOO\n#endif\n", "dds1")
+        with self.assertRaises(ValueError):
+            game_source("#ifdef NON_MATCHING\n#elif defined(SDF_DDS1)\n#endif\n", "dds1")
+
+
+class PathMapTest(unittest.TestCase):
+    def test_shared_directory_and_unit(self):
+        for unit, disk in (("src/smt3/sdf/sdfRand.c", "external/sdf-decomp/src/sdf/sdfRand.c"),
+                           ("src/smt3/mc/mcManager.c", "external/sdf-decomp/src/mc/mcManager.c"),
+                           ("src/smt3/model/mdlEffect.c", "external/sdf-decomp/src/model/mdlEffect.c"),
+                           ("src/smt3/script/scrTraceCode.c", "external/sdf-decomp/src/script/scrTraceCode.c"),
+                           ("src/smt3/script/scrCommonCommand.c", "external/sdf-decomp/src/script/scrCommonCommand.c"),
+                           ("src/smt3/script/scrParameterCommand.c", "src/smt3/script/scrParameterCommand.c"),
+                           ("src/smt3/effect/effPCPNeedle.c", "external/sdf-decomp/src/effect/effPCPNeedle.c"),
+                           ("src/smt3/effect/effPCPMisc.c", "src/smt3/effect/effPCPMisc.c"),
+                           ("src/smt3/mc/slMain.c", "src/smt3/mc/slMain.c")):
+            self.assertEqual(physical(Path(unit)), Path(disk))
+            self.assertEqual(logical(Path(disk)), Path(unit))
+
+
+if __name__ == "__main__":
+    unittest.main()

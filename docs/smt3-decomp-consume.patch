new file mode 100644
index 00000000..91bb6057
--- /dev/null
+++ b/tools/sources.py
@@ -0,0 +1,182 @@
+"""Where a unit's source lives.
+
+A unit keeps its name and its src/<version>/<unit>.c path everywhere else
+(splat, objects, reports); only the file itself may sit in a submodule.
+"""
+from __future__ import annotations
+
+import os
+import re
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+# Unit directories and single units compiled from a submodule, per version,
+# keyed by their path under src/<version>.
+SHARED = {
+    "smt3": {
+        "sdf": Path("external/sdf-decomp/src/sdf"),
+        "mc/mcManager.c": Path("external/sdf-decomp/src/mc/mcManager.c"),
+        "model": Path("external/sdf-decomp/src/model"),
+        "file/fileManager.c": Path("external/sdf-decomp/src/file/fileManager.c"),
+        "script/scrScriptProcess.c": Path("external/sdf-decomp/src/script/scrScriptProcess.c"),
+        "script/scrTraceCode.c": Path("external/sdf-decomp/src/script/scrTraceCode.c"),
+        "script/scrCommonCommand.c": Path("external/sdf-decomp/src/script/scrCommonCommand.c"),
+        "effect/effPCPNeedle.c": Path("external/sdf-decomp/src/effect/effPCPNeedle.c"),
+        "effect/polyManager.c": Path("external/sdf-decomp/src/effect/polyManager.c"),
+        "effect/effPart.c": Path("external/sdf-decomp/src/effect/effPart.c"),
+        "effect/effPCPFlash.c": Path("external/sdf-decomp/src/effect/effPCPFlash.c"),
+        "effect/effPCPScatter.c": Path("external/sdf-decomp/src/effect/effPCPScatter.c"),
+        "effect/parManager.c": Path("external/sdf-decomp/src/effect/parManager.c"),
+        "effect/effMath.c": Path("external/sdf-decomp/src/effect/effMath.c"),
+        "effect/effPacket.c": Path("external/sdf-decomp/src/effect/effPacket.c"),
+        "effect/effDebug.c": Path("external/sdf-decomp/src/effect/effDebug.c"),
+        "effect/effSpline.c": Path("external/sdf-decomp/src/effect/effSpline.c"),
+    },
+}
+
+# Header directories of those submodules, searched before include/.
+SHARED_INCLUDES = [Path("external/sdf-decomp/include")]
+
+
+def physical(path: Path, root: Path = ROOT) -> Path:
+    """Map a path under src/<version>, absolute or repo-relative, to the file on disk."""
+    path = Path(os.path.normpath(path))
+    absolute = path.is_absolute()
+    if absolute and not path.is_relative_to(root):
+        return path
+    rel = path.relative_to(root) if absolute else path
+    parts = rel.parts
+    if len(parts) > 2 and parts[0] == "src":
+        dirs = SHARED.get(parts[1], {})
+        unit = Path(*parts[2:]).as_posix()
+        if unit in dirs:
+            rel = dirs[unit]
+        elif len(parts) > 3 and parts[2] in dirs:
+            rel = dirs[parts[2]].joinpath(*parts[3:])
+    return root / rel if absolute else rel
+
+
+def logical(path: Path, root: Path = ROOT) -> Path:
+    """Map a file on disk back to its path under src/<version>; the inverse of physical()."""
+    path = Path(os.path.normpath(path))
+    absolute = path.is_absolute()
+    if absolute and not path.is_relative_to(root):
+        return path
+    rel = path.relative_to(root) if absolute else path
+    for version, dirs in SHARED.items():
+        for unit_dir, shared in dirs.items():
+            if rel == shared:
+                rel = Path("src", version, unit_dir)
+                break
+            if rel.is_relative_to(shared):
+                rel = Path("src", version, unit_dir) / rel.relative_to(shared)
+                break
+    return root / rel if absolute else rel
+
+
+def shared_files(version: str | None = None, root: Path = ROOT) -> list[Path]:
+    """The submodule's C units, absolute, for one version or all of them."""
+    out = []
+    for v, dirs in SHARED.items():
+        if version is not None and v != version:
+            continue
+        for d in dirs.values():
+            if d.suffix == ".c":
+                out += [root / d] if (root / d).is_file() else []
+            else:
+                out += sorted((root / d).rglob("*.c"))
+    return out
+
+
+def c_sources(version: str, root: Path = ROOT) -> list[Path]:
+    """Every C unit's file on disk, absolute, in src/<version> path order."""
+    own = list((root / "src" / version).rglob("*.c"))
+    return sorted(own + shared_files(version, root), key=lambda p: logical(p, root))
+
+
+def is_shared(path: Path, root: Path = ROOT) -> bool:
+    """Whether a file on disk is compiled from a submodule."""
+    path = Path(os.path.normpath(path))
+    return any(path == root / d or path.is_relative_to(root / d) for dirs in SHARED.values() for d in dirs.values())
+
+
+def unit_name(version: str, path: Path, root: Path = ROOT) -> str:
+    """A unit's name, src/<version>/ and .c dropped, for a file on disk."""
+    return logical(path, root).relative_to(root / "src" / version).with_suffix("").as_posix()
+
+
+def include_flags() -> str:
+    return " ".join(f"-I{p}" for p in SHARED_INCLUDES) + " -Iinclude -Isrc"
+
+
+GAME_MACROS = ("SDF_SMT3", "SDF_DDS1", "SDF_DDS2")
+DIRECTIVE = re.compile(r"\s*#\s*(if|ifdef|ifndef|elif|else|endif)\b(.*)")
+GAME_MACRO = re.compile(r"\b(?:defined\s*\(\s*(SDF_\w+)\s*\)|defined\s+(SDF_\w+)|(SDF_\w+))")
+# `#if defined(NON_MATCHING) || defined(SDF_DDS1) ...`: C for the games named, a
+# draft behind NON_MATCHING for the others.
+NON_MATCHING_OR = re.compile(r"defined\s*\(\s*NON_MATCHING\s*\)((?:\s*\|\|\s*defined\s*\(\s*SDF_\w+\s*\))+)")
+
+
+def game_condition(kind: str, argument: str, version: str) -> bool | None:
+    """Value of an #if on the game macros for `version`'s build; None for any other #if."""
+    game = f"SDF_{version.upper()}"
+    argument = re.sub(r"/\*.*?\*/|//.*", "", argument).strip()
+    if kind in ("ifdef", "ifndef"):
+        if argument not in GAME_MACROS:
+            return None
+        return (argument == game) == (kind == "ifdef")
+    if not any(re.search(rf"\b{m}\b", argument) for m in GAME_MACROS):
+        return None
+
+    def value(match: re.Match) -> str:
+        name = match.group(1) or match.group(2) or match.group(3)
+        if name not in GAME_MACROS:
+            raise ValueError(f"unknown game macro {name} in #{kind} {argument}")
+        return " 1 " if name == game else " 0 "
+
+    expr = GAME_MACRO.sub(value, argument)
+    expr = expr.replace("&&", " and ").replace("||", " or ").replace("!", " not ")
+    if not all(t in ("0", "1", "(", ")", "and", "or", "not") for t in re.findall(r"\w+|\S", expr)):
+        raise ValueError(f"#{kind} {argument} mixes the game macros with other terms")
+    return bool(eval(expr, {"__builtins__": {}}))
+
+
+def game_source(text: str, version: str) -> str:
+    """Blank what `version`'s build skips under #if on the SDF_* game macros.
+
+    Other conditionals keep every branch, as the text scans always have. Line
+    and character offsets are kept.
+    """
+    stack = []  # per open #if: (on the game macros, a branch taken so far, this branch taken)
+    out = []
+    for number, line in enumerate(text.splitlines(keepends=True), 1):
+        hidden = not all(taken for _, _, taken in stack)
+        control = False
+        directive = DIRECTIVE.match(line)
+        if directive:
+            kind, argument = directive.groups()
+            if kind in ("if", "ifdef", "ifndef"):
+                games = NON_MATCHING_OR.fullmatch(re.sub(r"/\*.*?\*/|//.*", "", argument).strip())
+                if games and f"SDF_{version.upper()}" not in re.findall(r"SDF_\w+", games.group(1)):
+                    stack.append((False, False, True))
+                    out.append("#ifdef NON_MATCHING".ljust(len(line.rstrip("\r\n"))) + line[len(line.rstrip("\r\n")):]
+                               if not hidden else re.sub(r"[^\r\n]", " ", line))
+                    continue
+                value = True if games else game_condition(kind, argument, version)
+                stack.append((value is not None, bool(value), value is not False))
+                control = value is not None
+            elif stack:
+                game, done, _ = stack[-1]
+                if kind == "endif":
+                    stack.pop()
+                elif kind == "else":
+                    stack[-1] = (game, True, not done if game else True)
+                else:
+                    value = game_condition("if", argument, version)
+                    if game != (value is not None):
+                        raise ValueError(f"line {number}: #elif mixes a game macro chain with another")
+                    stack[-1] = (game, done or bool(value), (not done and bool(value)) if game else True)
+                control = game
+        out.append(re.sub(r"[^\r\n]", " ", line) if hidden or control else line)
+    return "".join(out)
diff --git a/tools/splat_split.py b/tools/splat_split.py
new file mode 100644
index 00000000..27fd2414
--- /dev/null
+++ b/tools/splat_split.py
@@ -0,0 +1,39 @@
+#!/usr/bin/env python3
+"""`splat split`, reading a submodule unit's C from the submodule.
+
+Linker entries keep the src/<version> path, so object names do not move.
+"""
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from sources import physical  # noqa: E402
+
+from splat.__main__ import splat_main  # noqa: E402
+from splat.segtypes.common.c import CommonSegC  # noqa: E402
+
+source_path = CommonSegC.out_path
+
+
+def out_path(self):
+    path = source_path(self)
+    return physical(path) if path is not None and getattr(self, "reading_source", False) else path
+
+
+def reading_source(method):
+    def wrapper(self, *args, **kwargs):
+        self.reading_source = True
+        try:
+            return method(self, *args, **kwargs)
+        finally:
+            self.reading_source = False
+    return wrapper
+
+
+CommonSegC.out_path = out_path
+CommonSegC.scan = reading_source(CommonSegC.scan)
+CommonSegC.split = reading_source(CommonSegC.split)
+
+if __name__ == "__main__":
+    sys.argv[1:1] = ["split"]
+    splat_main()

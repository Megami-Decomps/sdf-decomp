@@ -0,0 +1,39 @@
+#!/usr/bin/env python3
+"""`splat split`, reading a submodule unit's C from the submodule.
+
+Linker entries keep the src/<version> path, so object names do not move.
+"""
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from sources import physical  # noqa: E402
+
+from splat.__main__ import splat_main  # noqa: E402
+from splat.segtypes.common.c import CommonSegC  # noqa: E402
+
+source_path = CommonSegC.out_path
+
+
+def out_path(self):
+    path = source_path(self)
+    return physical(path) if path is not None and getattr(self, "reading_source", False) else path
+
+
+def reading_source(method):
+    def wrapper(self, *args, **kwargs):
+        self.reading_source = True
+        try:
+            return method(self, *args, **kwargs)
+        finally:
+            self.reading_source = False
+    return wrapper
+
+
+CommonSegC.out_path = out_path
+CommonSegC.scan = reading_source(CommonSegC.scan)
+CommonSegC.split = reading_source(CommonSegC.split)
+
+if __name__ == "__main__":
+    sys.argv[1:1] = ["split"]
+    splat_main()

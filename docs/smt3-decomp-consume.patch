diff --git a/tools/sources.py b/tools/sources.py
new file mode 100644
index 00000000..f7907697
--- /dev/null
+++ b/tools/sources.py
@@ -0,0 +1,65 @@
+"""Where a unit's source lives.
+
+A unit keeps its name and its src/<version>/<unit>.c path everywhere else
+(splat, objects, reports); only the file itself may sit in a submodule.
+"""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+# Unit directories compiled from a submodule, per version.
+SHARED = {
+    "smt3": {"sdf": Path("external/sdf-decomp/src/sdf")},
+}
+
+# Header directories of those submodules, searched before include/.
+SHARED_INCLUDES = [Path("external/sdf-decomp/include")]
+
+
+def physical(path: Path, root: Path = ROOT) -> Path:
+    """Map a path under src/<version>, absolute or repo-relative, to the file on disk."""
+    path = Path(os.path.normpath(path))
+    absolute = path.is_absolute()
+    if absolute and not path.is_relative_to(root):
+        return path
+    rel = path.relative_to(root) if absolute else path
+    parts = rel.parts
+    if len(parts) > 3 and parts[0] == "src":
+        shared = SHARED.get(parts[1], {}).get(parts[2])
+        if shared is not None:
+            rel = shared.joinpath(*parts[3:])
+    return root / rel if absolute else rel
+
+
+def logical(path: Path, root: Path = ROOT) -> Path:
+    """Map a file on disk back to its path under src/<version>; the inverse of physical()."""
+    path = Path(os.path.normpath(path))
+    absolute = path.is_absolute()
+    if absolute and not path.is_relative_to(root):
+        return path
+    rel = path.relative_to(root) if absolute else path
+    for version, dirs in SHARED.items():
+        for unit_dir, shared in dirs.items():
+            if rel.is_relative_to(shared):
+                rel = Path("src", version, unit_dir) / rel.relative_to(shared)
+                break
+    return root / rel if absolute else rel
+
+
+def c_sources(version: str, root: Path = ROOT) -> list[Path]:
+    """Every C unit's file on disk, absolute, in src/<version> path order."""
+    own = list((root / "src" / version).rglob("*.c"))
+    shared = [p for d in SHARED.get(version, {}).values() for p in (root / d).rglob("*.c")]
+    return sorted(own + shared, key=lambda p: logical(p, root))
+
+
+def unit_name(version: str, path: Path, root: Path = ROOT) -> str:
+    """A unit's name, src/<version>/ and .c dropped, for a file on disk."""
+    return logical(path, root).relative_to(root / "src" / version).with_suffix("").as_posix()
+
+
+def include_flags() -> str:
+    return " ".join(f"-I{p}" for p in SHARED_INCLUDES) + " -Iinclude -Isrc"
